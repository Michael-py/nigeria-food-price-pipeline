{
  "expectation_suite_name": "worldbank_prices_suite",
  "meta": {
    "great_expectations_version": "0.18.0"
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {"min_value": 1000, "max_value": 100000},
      "meta": {"notes": "World Bank RTP should have substantial rows"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "market_name"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "commodity_name"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "price"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "price_date"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "market_name"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "commodity_name"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "price"}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {"column": "price", "min_value": 1, "max_value": 50000},
      "meta": {"notes": "RTP prices are in NGN, reasonable range for food commodities"}
    },
    {
      "expectation_type": "expect_column_distinct_values_to_be_in_set",
      "kwargs": {
        "column": "source",
        "value_set": ["WorldBank"]
      }
    }
  ]
}
