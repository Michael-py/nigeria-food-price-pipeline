# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=food_prices
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=changeme

# pgAdmin (browser-based database UI at http://localhost:5050)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline:changeme@postgres:5432/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=changeme-secret-key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://pipeline:changeme@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# Data Sources
# WFP: Leave blank to use HDX CSV download (no auth needed)
# To use DataBridges API: email wfp.vaminfo@wfp.org for credentials
WFP_API_KEY=
WFP_API_SECRET=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
STREAMLIT_SERVER_PORT=8501
